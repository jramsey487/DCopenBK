# Local development — copy to `.env` in the project root:
#   cp .env.example .env
#
# Dev management commands (bootstrap_dev, create_dev_user) require DEBUG=True.

DEBUG=True

# Optional: override the default local Postgres URL from settings.py
# Default (matches historical local setup): postgres://iosue:password@localhost/citiopen
# Common Homebrew / EDB install:
# DATABASE_URL=postgres://postgres:password@localhost:5432/citiopen

# SECRET_KEY is optional locally (a insecure default is used if unset)
# SECRET_KEY=change-me-in-production
