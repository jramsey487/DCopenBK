# Local development — copy to `.env` in the project root:
#   cp .env.example .env
#
# Dev management commands (bootstrap_dev, create_dev_user) require DEBUG=True.

DEBUG=True

# Optional: override the default local Postgres URL from settings.py
# Default (matches historical local setup): postgres://iosue:password@localhost/citiopen
# Common Homebrew / EDB install:
# DATABASE_URL=postgres://postgres:password@localhost:5432/citiopen

# SECRET_KEY is optional for local development (DEBUG=True uses a dev-only key).
# Production (DEBUG=False) must set a strong, private SECRET_KEY as a Fly secret.
# SECRET_KEY=replace-with-a-long-random-secret

# Optional canonical site URL (defaults to https://dcopenbk.com).
# SITE_BASE_URL=https://dcopenbk.com
#
# Optional host/origin overrides. Defaults include dcopenbk.com, www.dcopenbk.com,
# and the dcopenbk.fly.dev hostname.
# ALLOWED_HOSTS=dcopenbk.com,www.dcopenbk.com,dcopenbk.fly.dev
# CSRF_TRUSTED_ORIGINS=https://dcopenbk.com,https://www.dcopenbk.com,https://dcopenbk.fly.dev
